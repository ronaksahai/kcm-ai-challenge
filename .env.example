# KCM AI Suite - Configuration

# Replace the placeholder below with your actual Sarvam AI API key
SARVAM_API_KEY=your_sarvam_api_key_here

# Google Cloud Platform (Vertex AI) Settings for Order Scrutiny and Notice Reply modules
# Ensure you have set up your ADC (Application Default Credentials) or have a service_account.json
# and set the GOOGLE_APPLICATION_CREDENTIALS environment variable.
GCP_PROJECT_ID=your_gcp_project_id_here
GCP_LOCATION=us-central1
